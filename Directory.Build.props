<Project>
  <!-- The version lives in version.txt. The assemblies, the app's version label and the publish script all read it from there. -->
  <PropertyGroup>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.txt').Trim())</Version>
    <Product>A StoryWealth Installer</Product>
  </PropertyGroup>

  <!-- The installer is Windows-only today (DPAPI key store, registry game discovery, Mod Organizer 2). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
