<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../NexusApi/AStoryWealth.NexusApi.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- shipped structured priority orders (see PriorityOrder.LoadShipped) -->
    <EmbeddedResource Include="Data/*.priority.json" />
    <EmbeddedResource Include="Data/*.optional.json" />
    <EmbeddedResource Include="Data/addon-options.json" />
  </ItemGroup>

</Project>
